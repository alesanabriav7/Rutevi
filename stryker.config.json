{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.js",
    "!src/cli.js"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html",
    "json"
  ],
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
