{
  "name": "rutevi",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Route tasks with Jev before launching Codex, OpenCode or Claude Code.",
  "bin": {
    "rutevi": "src/cli.js",
    "router-jev": "src/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "audit:models": "node src/cli.js audit",
    "eval:live": "node test/live-eval.js",
    "eval:opencode": "node test/live-opencode-eval.js",
    "smoke:opencode": "node test/live-opencode-smoke.js",
    "probe:models": "node test/probe-models.js",
    "install:codex": "node scripts/install-integrations.mjs codex",
    "install:opencode": "node scripts/install-integrations.mjs opencode",
    "smoke:codex-session": "node test/live-codex-session.js",
    "smoke:opencode-session": "node test/live-opencode-session.js",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.json",
    "knip": "knip",
    "test:mutation": "stryker run",
    "quality": "npm run lint && npm run typecheck && npm test && npm run knip",
    "quality:full": "npm run quality && npm run test:mutation"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "blessed": "0.1.81"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.20.4",
    "fast-check": "^4.10.2",
    "knip": "^6.37.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
